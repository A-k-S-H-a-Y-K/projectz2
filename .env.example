# Copy this file to .env and fill in your own values.

# Server
PORT=3001
# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:3000

# PostgreSQL: pooled connection for the app, direct connection for migrations.
# With a local database, both can be the same URL.
DATABASE_URL=postgresql://user:password@localhost:5432/memory_assistant
DIRECT_URL=postgresql://user:password@localhost:5432/memory_assistant

# Auth: use a long random string for JWT_SECRET
JWT_SECRET=change-me
# Token lifetime in seconds, or a duration like 30m, 12h, 7d
JWT_EXPIRES_IN=7d

# Pinecone vector database. Create the index with: npm run pinecone:setup
PINECONE_API_KEY=
PINECONE_INDEX_NAME=memories

# Google Gemini (free key from https://aistudio.google.com)
GEMINI_API_KEY=
# Optional: chat model used to write answers
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
