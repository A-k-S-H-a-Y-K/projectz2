# Copy this file to .env and fill in your own values.

# Server
PORT=3001
# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/memory_assistant

# Auth: use a long random string for JWT_SECRET
JWT_SECRET=change-me
# Token lifetime in seconds, or a duration like 30m, 12h, 7d
JWT_EXPIRES_IN=7d

# Pinecone vector database (index dimension must be 1024 for mistral-embed)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=memories

# Mistral AI
MISTRAL_API_KEY=
# Optional: chat model used to write answers
MISTRAL_CHAT_MODEL=mistral-medium-latest
