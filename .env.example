# Copy this file to .env and fill in your own values.

# Server
PORT=3001
# Frontend URL(s) allowed to call the API, comma-separated (required in production)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL: pooled connection for the app, direct connection for migrations.
# With a local database, both can be the same URL.
DATABASE_URL=postgresql://user:password@localhost:5432/memory_assistant
DIRECT_URL=postgresql://user:password@localhost:5432/memory_assistant

# Auth: use a long random string for JWT_SECRET (at least 32 characters in production)
JWT_SECRET=change-me
# Token lifetime in seconds, or a duration like 30m, 12h, 7d
JWT_EXPIRES_IN=7d

# Who can create accounts: open, invite (needs INVITE_CODE) or closed.
# Defaults to closed when NODE_ENV=production, open otherwise.
SIGNUP_MODE=open
INVITE_CODE=
# Read-only demo account (fill it with: npm run demo:seed). Set to false to disable.
DEMO_ENABLED=true

# Rate limits
AI_QUESTIONS_PER_HOUR=20
AI_QUESTIONS_PER_DAY=200
AUTH_ATTEMPTS_PER_15_MIN=10
# Set to true when running behind a hosting provider's proxy, so limits use the visitor's IP
TRUST_PROXY=false

# Pinecone vector database. Create the index with: npm run pinecone:setup
PINECONE_API_KEY=
PINECONE_INDEX_NAME=memories

# Google Gemini (free key from https://aistudio.google.com)
GEMINI_API_KEY=
# Optional: chat model used to write answers
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# Optional: how long to wait for an answer before giving up (milliseconds)
ANSWER_TIMEOUT_MS=30000
# Optional: memories scoring below this similarity (0 to 1) are ignored
MIN_RELEVANCE_SCORE=0.55
